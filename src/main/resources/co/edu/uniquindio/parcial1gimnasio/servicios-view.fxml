<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uniquindio.parcial1gimnasio.viewController.ServicioAdicionalViewController"
            stylesheets="@styles.css"
            styleClass="client-root">

    <!-- ================================================= -->
    <!-- BARRA SUPERIOR -->
    <!-- ================================================= -->

    <top>

        <HBox styleClass="client-topbar">

            <!-- LOGO + NOMBRE -->
            <HBox alignment="CENTER_LEFT"
                  spacing="10">

                <ImageView fitHeight="42"
                           fitWidth="42"
                           preserveRatio="true">

                    <Image url="@logo_mancuerna_smartgym.png"/>

                </ImageView>

                <VBox alignment="CENTER_LEFT">

                    <Label text="SMARTGYM"
                           styleClass="client-logo-orange"/>

                    <Label text="Gestión de servicios"
                           styleClass="client-topbar-subtitle"/>

                </VBox>

            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- BOTÓN VOLVER -->
            <Button text="← Volver"
                    onAction="#volverMenu"
                    styleClass="client-back-button"/>

        </HBox>

    </top>


    <!-- ================================================= -->
    <!-- CONTENIDO -->
    <!-- ================================================= -->

    <center>

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="client-scroll">

            <content>

                <VBox spacing="18"
                      styleClass="client-page">

                    <padding>
                        <Insets top="22"
                                right="28"
                                bottom="25"
                                left="28"/>
                    </padding>


                    <!-- ================================================= -->
                    <!-- ENCABEZADO -->
                    <!-- ================================================= -->

                    <HBox alignment="CENTER_LEFT"
                          spacing="15"
                          styleClass="client-page-header">

                        <VBox spacing="4">

                            <Label text="Servicios adicionales"
                                   styleClass="client-main-title"/>

                            <Label text="Registra y administra los servicios complementarios ofrecidos por SmartGym."
                                   styleClass="client-main-subtitle"/>

                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <VBox alignment="CENTER"
                              styleClass="client-header-badge">

                            <Label text="SERVICIOS"
                                   styleClass="client-badge-title"/>

                            <Label text="Gestión"
                                   styleClass="client-badge-subtitle"/>

                        </VBox>

                    </HBox>


                    <!-- ================================================= -->
                    <!-- TARJETA PRINCIPAL -->
                    <!-- ================================================= -->

                    <VBox spacing="18"
                          styleClass="client-card">


                        <!-- TITULO -->

                        <HBox alignment="CENTER_LEFT"
                              spacing="12">

                            <Label text="⚙"
                                   styleClass="client-section-icon"/>

                            <VBox spacing="2">

                                <Label text="Datos del servicio"
                                       styleClass="client-section-title"/>

                                <Label text="Complete la información para registrar o modificar un servicio adicional."
                                       styleClass="client-section-subtitle"/>

                            </VBox>

                        </HBox>


                        <!-- ================================================= -->
                        <!-- FORMULARIO -->
                        <!-- ================================================= -->

                        <VBox spacing="12"
                              styleClass="client-form">


                            <!-- CODIGO -->

                            <VBox spacing="5">

                                <Label text="Código"
                                       styleClass="form-label"/>

                                <TextField fx:id="txtCodigo"
                                           promptText="Ej. SER001"
                                           styleClass="client-field"/>

                            </VBox>


                            <!-- NOMBRE -->

                            <VBox spacing="5">

                                <Label text="Nombre"
                                       styleClass="form-label"/>

                                <TextField fx:id="txtNombre"
                                           promptText="Ej. Valoración física"
                                           styleClass="client-field"/>

                            </VBox>


                            <!-- DESCRIPCION -->

                            <VBox spacing="5">

                                <Label text="Descripción"
                                       styleClass="form-label"/>

                                <TextField fx:id="txtDescripcion"
                                           promptText="Describe el servicio"
                                           styleClass="client-field"/>

                            </VBox>


                            <!-- PRECIO -->

                            <VBox spacing="5">

                                <Label text="Precio"
                                       styleClass="form-label"/>

                                <HBox alignment="CENTER_LEFT"
                                      spacing="8">

                                    <Label text="COP"
                                           styleClass="client-badge-title"/>

                                    <TextField fx:id="txtPrecio"
                                               promptText="Ej. 50000"
                                               HBox.hgrow="ALWAYS"
                                               styleClass="client-field"/>

                                </HBox>

                            </VBox>


                            <!-- DISPONIBILIDAD -->

                            <HBox alignment="CENTER_LEFT"
                                  spacing="10">

                                <CheckBox fx:id="chkDisponible"
                                          text="Servicio disponible"
                                          selected="true"/>

                                <Label text="Los servicios no disponibles no podrán agregarse a una inscripción."
                                       styleClass="client-topbar-subtitle"/>

                            </HBox>

                        </VBox>


                        <!-- ================================================= -->
                        <!-- INFORMACION -->
                        <!-- ================================================= -->

                        <HBox alignment="CENTER_LEFT"
                              spacing="10"
                              styleClass="client-info-box">

                            <Label text="i"
                                   styleClass="info-icon"/>

                            <Label text="Los servicios registrados podrán asociarse a las inscripciones de los clientes y su valor se incluirá en el pago final."
                                   wrapText="true"
                                   styleClass="info-text"/>

                        </HBox>


                        <!-- ================================================= -->
                        <!-- BOTONES CRUD -->
                        <!-- ================================================= -->

                        <HBox spacing="10"
                              alignment="CENTER">

                            <Button fx:id="btnRegistrar"
                                    text="✓   Registrar servicio"
                                    onAction="#registrarServicio"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity"
                                    styleClass="client-primary-button"/>

                            <Button text="🔎   Buscar servicio"
                                    onAction="#buscarServicio"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity"
                                    styleClass="client-primary-button"/>

                            <Button fx:id="btnActualizar"
                                    text="✎   Guardar cambios"
                                    onAction="#actualizarServicio"
                                    disable="true"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity"
                                    styleClass="client-primary-button"/>

                            <Button fx:id="btnEliminar"
                                    text="✕   Eliminar servicio"
                                    onAction="#eliminarServicio"
                                    disable="true"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity"
                                    styleClass="client-primary-button"/>

                        </HBox>

                    </VBox>


                    <!-- ================================================= -->
                    <!-- FOOTER -->
                    <!-- ================================================= -->

                    <HBox spacing="4"
                          styleClass="client-footer">

                        <Label text="SMARTGYM"
                               styleClass="client-footer-brand"/>

                        <Label text="•  Gestión de servicios adicionales"
                               styleClass="client-footer-text"/>

                    </HBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>