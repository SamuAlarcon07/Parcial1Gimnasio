<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.uniquindio.parcial1gimnasio.viewController.ServicioAdicionalViewController"
      spacing="15">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Servicios Adicionales"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">

        <Label text="Código:"
               GridPane.rowIndex="0"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtCodigo"
                   promptText="Código del servicio"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="1"/>

        <Label text="Nombre:"
               GridPane.rowIndex="1"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtNombre"
                   promptText="Nombre del servicio"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="1"/>

        <Label text="Descripción:"
               GridPane.rowIndex="2"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtDescripcion"
                   promptText="Descripción"
                   GridPane.rowIndex="2"
                   GridPane.columnIndex="1"/>

        <Label text="Precio:"
               GridPane.rowIndex="3"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtPrecio"
                   promptText="Precio"
                   GridPane.rowIndex="3"
                   GridPane.columnIndex="1"/>

    </GridPane>

    <Button text="Registrar servicio"
            onAction="#registrarServicio"
            prefWidth="220"/>

</VBox>