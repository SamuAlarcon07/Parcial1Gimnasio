<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.uniquindio.parcial1gimnasio.viewController.ClientesViewController"
      spacing="15">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Gestión de Clientes"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">

        <Label text="Nombre completo:"
               GridPane.rowIndex="0"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtNombre"
                   promptText="Nombre completo"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="1"/>


        <Label text="Documento:"
               GridPane.rowIndex="1"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtDocumento"
                   promptText="Documento"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="1"/>


        <Label text="Teléfono:"
               GridPane.rowIndex="2"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtTelefono"
                   promptText="Teléfono"
                   GridPane.rowIndex="2"
                   GridPane.columnIndex="1"/>


        <Label text="Correo:"
               GridPane.rowIndex="3"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtEmail"
                   promptText="Correo electrónico"
                   GridPane.rowIndex="3"
                   GridPane.columnIndex="1"/>


        <Label text="Edad:"
               GridPane.rowIndex="4"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtEdad"
                   promptText="Edad"
                   GridPane.rowIndex="4"
                   GridPane.columnIndex="1"/>

    </GridPane>

    <Button text="Registrar cliente"
            onAction="#registrarCliente"
            prefWidth="200"/>

    <Label text="Buscar cliente por teléfono"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TextField fx:id="txtTelefonoBuscar"
               promptText="Ingrese el teléfono"/>

    <Button text="Buscar cliente"
            onAction="#buscarCliente"
            prefWidth="200"/>

    <Button text="Comprobar número perfecto"
            onAction="#comprobarNumeroPerfecto"
            prefWidth="200"/>

</VBox>