<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uniquindio.parcial1gimnasio.viewController.ClientesViewController"
            stylesheets="@styles.css"
            styleClass="client-root">


    <!-- ========================================================= -->
    <!-- BARRA SUPERIOR -->
    <!-- ========================================================= -->

    <top>

        <HBox styleClass="client-topbar"
              alignment="CENTER_LEFT">

            <HBox alignment="CENTER_LEFT"
                  spacing="10">

                <ImageView fitHeight="42"
                           fitWidth="42"
                           preserveRatio="true">

                    <image>
                        <Image url="@logo_mancuerna_smartgym.png"/>
                    </image>

                </ImageView>

                <VBox alignment="CENTER_LEFT">

                    <Label text="SMARTGYM"
                           styleClass="client-logo-orange"/>

                    <Label text="Gestión de clientes"
                           styleClass="client-topbar-subtitle"/>

                </VBox>

            </HBox>


            <Region HBox.hgrow="ALWAYS"/>


            <Button text="← Volver al menú"
                    onAction="#volverMenu"
                    styleClass="client-back-button"/>

        </HBox>

    </top>


    <!-- ========================================================= -->
    <!-- CONTENIDO -->
    <!-- ========================================================= -->

    <center>

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="client-scroll">

            <content>

                <VBox spacing="18"
                      styleClass="client-page">

                    <padding>

                        <Insets top="22"
                                right="28"
                                bottom="25"
                                left="28"/>

                    </padding>


                    <!-- ================================================= -->
                    <!-- ENCABEZADO -->
                    <!-- ================================================= -->

                    <HBox alignment="CENTER_LEFT"
                          spacing="15"
                          styleClass="client-page-header">

                        <VBox spacing="4">

                            <Label text="Gestión de Clientes"
                                   styleClass="client-main-title"/>

                            <Label text="Registra, busca y administra la información de los clientes de SmartGym."
                                   styleClass="client-main-subtitle"/>

                        </VBox>


                        <Region HBox.hgrow="ALWAYS"/>


                        <VBox alignment="CENTER"
                              styleClass="client-header-badge">

                            <Label text="CLIENTES"
                                   styleClass="client-badge-title"/>

                            <Label text="GESTIÓN"
                                   styleClass="client-badge-subtitle"/>

                        </VBox>

                    </HBox>


                    <!-- ================================================= -->
                    <!-- REGISTRAR / EDITAR -->
                    <!-- ================================================= -->

                    <VBox spacing="18"
                          styleClass="client-card">

                        <HBox alignment="CENTER_LEFT"
                              spacing="12">

                            <Label text="01"
                                   styleClass="client-section-icon"/>

                            <VBox spacing="2">

                                <Label text="Registrar / editar cliente"
                                       styleClass="client-section-title"/>

                                <Label text="Complete los datos personales del cliente."
                                       styleClass="client-section-subtitle"/>

                            </VBox>

                        </HBox>


                        <!-- NOMBRE -->

                        <HBox alignment="CENTER_LEFT"
                              spacing="12">

                            <Label text="Nombre completo"
                                   prefWidth="130"
                                   styleClass="form-label"/>

                            <TextField fx:id="txtNombre"
                                       promptText="Ej. Juan Pérez"
                                       HBox.hgrow="ALWAYS"
                                       styleClass="client-field"/>

                        </HBox>


                        <!-- DOCUMENTO -->

                        <HBox alignment="CENTER_LEFT"
                              spacing="12">

                            <Label text="Documento"
                                   prefWidth="130"
                                   styleClass="form-label"/>

                            <TextField fx:id="txtDocumento"
                                       promptText="Número de documento"
                                       HBox.hgrow="ALWAYS"
                                       styleClass="client-field"/>

                        </HBox>


                        <!-- TELEFONO -->

                        <HBox alignment="CENTER_LEFT"
                              spacing="12">

                            <Label text="Teléfono"
                                   prefWidth="130"
                                   styleClass="form-label"/>

                            <TextField fx:id="txtTelefono"
                                       promptText="Número de teléfono"
                                       HBox.hgrow="ALWAYS"
                                       styleClass="client-field"/>

                        </HBox>


                        <!-- CORREO -->

                        <HBox alignment="CENTER_LEFT"
                              spacing="12">

                            <Label text="Correo electrónico"
                                   prefWidth="130"
                                   styleClass="form-label"/>

                            <TextField fx:id="txtEmail"
                                       promptText="correo@ejemplo.com"
                                       HBox.hgrow="ALWAYS"
                                       styleClass="client-field"/>

                        </HBox>


                        <!-- EDAD -->

                        <HBox alignment="CENTER_LEFT"
                              spacing="12">

                            <Label text="Edad"
                                   prefWidth="130"
                                   styleClass="form-label"/>

                            <TextField fx:id="txtEdad"
                                       promptText="Edad en años"
                                       HBox.hgrow="ALWAYS"
                                       styleClass="client-field"/>

                        </HBox>


                        <!-- ================================================= -->
                        <!-- BOTON REGISTRAR -->
                        <!-- ================================================= -->

                        <Button fx:id="btnRegistrar"
                                text="✓   Registrar cliente"
                                onAction="#registrarCliente"
                                maxWidth="Infinity"
                                styleClass="client-primary-button"/>


                        <!-- ================================================= -->
                        <!-- BOTONES CRUD -->
                        <!-- ================================================= -->

                        <HBox spacing="10">

                            <Button fx:id="btnActualizar"
                                    text="✎   Guardar cambios"
                                    onAction="#actualizarCliente"
                                    disable="true"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity"
                                    styleClass="client-secondary-button"/>


                            <Button fx:id="btnEliminar"
                                    text="✕   Eliminar cliente"
                                    onAction="#eliminarCliente"
                                    disable="true"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity"
                                    styleClass="client-secondary-button"/>

                        </HBox>

                    </VBox>


                    <!-- ================================================= -->
                    <!-- BUSCAR CLIENTE -->
                    <!-- ================================================= -->

                    <VBox spacing="18"
                          styleClass="client-card">

                        <HBox alignment="CENTER_LEFT"
                              spacing="12">

                            <Label text="02"
                                   styleClass="client-section-icon"/>

                            <VBox spacing="2">

                                <Label text="Buscar cliente"
                                       styleClass="client-section-title"/>

                                <Label text="Encuentra un cliente utilizando su número de teléfono."
                                       styleClass="client-section-subtitle"/>

                            </VBox>

                        </HBox>


                        <HBox alignment="CENTER_LEFT"
                              spacing="10">

                            <TextField fx:id="txtTelefonoBuscar"
                                       promptText="Ingrese el número de teléfono"
                                       HBox.hgrow="ALWAYS"
                                       styleClass="client-field"/>

                            <Button text="Buscar"
                                    onAction="#buscarCliente"
                                    styleClass="client-secondary-button"/>

                        </HBox>


                        <!-- ================================================= -->
                        <!-- NUMERO PERFECTO -->
                        <!-- ================================================= -->

                        <VBox spacing="12"
                              styleClass="perfect-number-box">

                            <HBox alignment="CENTER_LEFT"
                                  spacing="10">

                                <Label text="✓"
                                       styleClass="perfect-icon"/>

                                <VBox spacing="2"
                                      HBox.hgrow="ALWAYS">

                                    <Label text="Comprobar número perfecto"
                                           styleClass="perfect-title"/>

                                    <Label text="Verifica si el número de teléfono corresponde a un número perfecto."
                                           wrapText="true"
                                           styleClass="perfect-description"/>

                                </VBox>

                            </HBox>


                            <HBox spacing="10">

                                <TextField text="@txtTelefonoBuscar"
                                           visible="false"
                                           managed="false"/>

                                <Button text="Comprobar"
                                        onAction="#comprobarNumeroPerfecto"
                                        maxWidth="Infinity"
                                        HBox.hgrow="ALWAYS"
                                        styleClass="perfect-button"/>

                            </HBox>

                        </VBox>

                    </VBox>


                    <!-- ================================================= -->
                    <!-- INFORMACION -->
                    <!-- ================================================= -->

                    <HBox alignment="CENTER_LEFT"
                          spacing="10"
                          styleClass="client-info-box">

                        <Label text="i"
                               styleClass="info-icon"/>

                        <Label text="Busca un cliente para cargar sus datos en el formulario. Después puedes modificarlos y guardar los cambios, o eliminar el registro."
                               wrapText="true"
                               styleClass="info-text"/>

                    </HBox>


                    <!-- ================================================= -->
                    <!-- PIE -->
                    <!-- ================================================= -->

                    <HBox spacing="4"
                          styleClass="client-footer">

                        <Label text="SMARTGYM"
                               styleClass="client-footer-brand"/>

                        <Label text="•  Gestión de clientes"
                               styleClass="client-footer-text"/>

                    </HBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>