<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.uniquindio.parcial1gimnasio.viewController.EntrenadorViewController"
      spacing="15">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Gestión de Entrenadores"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">

        <Label text="Identificación:"
               GridPane.rowIndex="0"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtIdentificacion"
                   promptText="Identificación"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="1"/>


        <Label text="Nombre:"
               GridPane.rowIndex="1"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtNombre"
                   promptText="Nombre completo"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="1"/>


        <Label text="Especialidad:"
               GridPane.rowIndex="2"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtEspecialidad"
                   promptText="Especialidad"
                   GridPane.rowIndex="2"
                   GridPane.columnIndex="1"/>


        <Label text="Teléfono:"
               GridPane.rowIndex="3"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtTelefono"
                   promptText="Teléfono"
                   GridPane.rowIndex="3"
                   GridPane.columnIndex="1"/>


        <Label text="Tarifa por sesión:"
               GridPane.rowIndex="4"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtTarifa"
                   promptText="Tarifa por sesión"
                   GridPane.rowIndex="4"
                   GridPane.columnIndex="1"/>

    </GridPane>

    <Button text="Registrar entrenador"
            onAction="#registrarEntrenador"
            prefWidth="220"/>

</VBox>