<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.uniquindio.parcial1gimnasio.viewController.PlanViewController"
      spacing="15">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Gestión de Planes"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">

        <Label text="Tipo de plan:"
               GridPane.rowIndex="0"
               GridPane.columnIndex="0"/>

        <ComboBox fx:id="cmbTipoPlan"
                  prefWidth="220"
                  GridPane.rowIndex="0"
                  GridPane.columnIndex="1"/>

        <Label text="Código:"
               GridPane.rowIndex="1"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtCodigo"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="1"/>

        <Label text="Nombre:"
               GridPane.rowIndex="2"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtNombre"
                   GridPane.rowIndex="2"
                   GridPane.columnIndex="1"/>

        <Label text="Descripción:"
               GridPane.rowIndex="3"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtDescripcion"
                   GridPane.rowIndex="3"
                   GridPane.columnIndex="1"/>

        <Label text="Duración (meses):"
               GridPane.rowIndex="4"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtDuracion"
                   GridPane.rowIndex="4"
                   GridPane.columnIndex="1"/>

        <Label text="Valor mensual:"
               GridPane.rowIndex="5"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtValorMensual"
                   GridPane.rowIndex="5"
                   GridPane.columnIndex="1"/>

        <Label text="Sesiones:"
               GridPane.rowIndex="6"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtSesiones"
                   GridPane.rowIndex="6"
                   GridPane.columnIndex="1"/>

        <Label text="Especialidad:"
               GridPane.rowIndex="7"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtEspecialidad"
                   GridPane.rowIndex="7"
                   GridPane.columnIndex="1"/>

        <Label text="Objetivos:"
               GridPane.rowIndex="8"
               GridPane.columnIndex="0"/>

        <TextField fx:id="txtObjetivos"
                   GridPane.rowIndex="8"
                   GridPane.columnIndex="1"/>

    </GridPane>

    <Button text="Crear plan"
            onAction="#crearPlan"
            prefWidth="220"/>

</VBox>