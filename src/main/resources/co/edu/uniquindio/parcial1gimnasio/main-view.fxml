<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.scene.control.Button?>
        <?import javafx.scene.control.Label?>
        <?import javafx.scene.control.ScrollPane?>
        <?import javafx.scene.control.Separator?>
        <?import javafx.scene.control.TableColumn?>
        <?import javafx.scene.control.TableView?>
        <?import javafx.scene.effect.GaussianBlur?>
        <?import javafx.scene.image.Image?>
        <?import javafx.scene.image.ImageView?>
        <?import javafx.scene.layout.BorderPane?>
        <?import javafx.scene.layout.ColumnConstraints?>
        <?import javafx.scene.layout.GridPane?>
        <?import javafx.scene.layout.HBox?>
        <?import javafx.scene.layout.Region?>
        <?import javafx.scene.layout.RowConstraints?>
        <?import javafx.scene.layout.StackPane?>
        <?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.parcial1gimnasio.viewController.MainViewController"
            stylesheets="@styles.css">

    <!-- ========================================================= -->
    <!-- SIDEBAR -->
    <!-- ========================================================= -->

    <left>

        <VBox styleClass="sidebar"
              prefWidth="215"
              minWidth="215"
              maxWidth="215">

            <!-- ================================================= -->
            <!-- LOGO -->
            <!-- ================================================= -->

            <VBox spacing="3"
                  styleClass="logo-container">

                <HBox alignment="CENTER_LEFT"
                      spacing="7">

                    <ImageView fx:id="imgLogo"
                               fitWidth="34"
                               fitHeight="34"
                               preserveRatio="true"
                               smooth="true">

                        <image>
                            <Image url="@logo_mancuerna_smartgym.png"/>
                        </image>

                    </ImageView>

                    <HBox spacing="0">

                        <Label text="Smart"
                               styleClass="logo"/>

                        <Label text="Gym"
                               styleClass="logo-orange"/>

                    </HBox>

                </HBox>

                <Label text="Sistema de gestión"
                       styleClass="logo-subtitle"/>

                <Label text="de gimnasio"
                       styleClass="logo-subtitle"/>

            </VBox>


            <!-- ================================================= -->
            <!-- MENU -->
            <!-- ================================================= -->

            <VBox spacing="7"
                  styleClass="sidebar-menu">

                <Button text="⌂   Inicio"
                        styleClass="menu-button-active"
                        maxWidth="Infinity"/>

                <Button text="♟   Clientes"
                        onAction="#abrirClientes"
                        styleClass="menu-button"
                        maxWidth="Infinity"/>

                <Button text="⚒   Planes"
                        onAction="#abrirPlanes"
                        styleClass="menu-button"
                        maxWidth="Infinity"/>

                <Button text="♟   Entrenadores"
                        onAction="#abrirEntrenadores"
                        styleClass="menu-button"
                        maxWidth="Infinity"/>

                <Button text="⚙   Servicios"
                        onAction="#abrirServicios"
                        styleClass="menu-button"
                        maxWidth="Infinity"/>

                <Button text="✓   Inscripciones"
                        onAction="#abrirInscripciones"
                        styleClass="menu-button"
                        maxWidth="Infinity"/>

                <Button text="▥   Reportes"
                        onAction="#abrirReportes"
                        styleClass="menu-button"
                        maxWidth="Infinity"/>

            </VBox>


            <!-- ================================================= -->
            <!-- ESPACIO FLEXIBLE -->
            <!-- ================================================= -->

            <Region VBox.vgrow="ALWAYS"/>


            <!-- ================================================= -->
            <!-- IMAGEN INFERIOR DEL SIDEBAR -->
            <!-- ================================================= -->

            <StackPane styleClass="sidebar-photo">

                <ImageView fx:id="imgSidebar"
                           fitWidth="215"
                           fitHeight="270"
                           preserveRatio="false"
                           smooth="true"
                           mouseTransparent="true"
                           pickOnBounds="false">

                    <image>
                        <Image url="@sidebar-gym.png"/>
                    </image>

                    <effect>
                        <GaussianBlur radius="2.5"/>
                    </effect>

                </ImageView>


                <Region styleClass="sidebar-photo-overlay"
                        mouseTransparent="true"/>


                <VBox alignment="BOTTOM_LEFT"
                      styleClass="sidebar-photo-content">

                    <Label text="DISCIPLINA"
                           styleClass="sidebar-photo-title"/>

                    <Label text="SALUD"
                           styleClass="sidebar-photo-title"/>

                    <Label text="BIENESTAR"
                           styleClass="sidebar-photo-orange"/>

                    <Label text="━━"
                           styleClass="sidebar-photo-line"/>

                </VBox>

            </StackPane>

        </VBox>

    </left>


    <!-- ========================================================= -->
    <!-- CONTENIDO PRINCIPAL -->
    <!-- ========================================================= -->

    <center>

        <ScrollPane fitToWidth="true"
                    fitToHeight="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="main-scroll">

            <VBox styleClass="main-content"
                  fillWidth="true">


                <!-- ================================================= -->
                <!-- HEADER -->
                <!-- ================================================= -->

                <HBox styleClass="top-header"
                      alignment="CENTER_RIGHT">

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label text="●    Usuario: Administrador"
                           styleClass="header-text"/>

                    <Separator orientation="VERTICAL"
                               styleClass="header-separator"/>

                    <!-- FECHA Y HORA FUNCIONAL -->

                    <Label fx:id="lblFechaHora"
                           text="Cargando..."
                           styleClass="header-text"/>

                </HBox>


                <!-- ================================================= -->
                <!-- HERO -->
                <!-- ================================================= -->

                <StackPane styleClass="hero">

                    <ImageView fx:id="imgBanner"
                               preserveRatio="false"
                               smooth="true"
                               mouseTransparent="true"
                               pickOnBounds="false">

                        <image>
                            <Image url="@banner.png"/>
                        </image>

                    </ImageView>


                    <Region styleClass="hero-overlay"
                            mouseTransparent="true"/>


                    <HBox alignment="CENTER_LEFT"
                          styleClass="hero-content">

                        <VBox spacing="8"
                              maxWidth="520">

                            <Label text="BIENVENIDO A"
                                   styleClass="hero-title-small"/>

                            <HBox spacing="0">

                                <Label text="SMART"
                                       styleClass="hero-title"/>

                                <Label text="GYM"
                                       styleClass="hero-title-orange"/>

                            </HBox>

                            <Label text="Gestiona tus clientes, planes, entrenadores&#10;y mucho más, todo en un solo lugar."
                                   wrapText="true"
                                   styleClass="hero-description"/>

                            <Label text="━"
                                   styleClass="orange-line"/>

                            <Label text="“Un cuerpo sano, una mente más fuerte.”"
                                   styleClass="hero-phrase"/>

                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                    </HBox>

                </StackPane>


                <!-- ================================================= -->
                <!-- MODULOS PRINCIPALES -->
                <!-- ================================================= -->

                <Label text="Módulos principales"
                       styleClass="section-title"/>


                <GridPane hgap="12"
                          vgap="12"
                          styleClass="modules-grid">

                    <columnConstraints>

                        <ColumnConstraints percentWidth="16.66"
                                           hgrow="ALWAYS"/>

                        <ColumnConstraints percentWidth="16.66"
                                           hgrow="ALWAYS"/>

                        <ColumnConstraints percentWidth="16.66"
                                           hgrow="ALWAYS"/>

                        <ColumnConstraints percentWidth="16.66"
                                           hgrow="ALWAYS"/>

                        <ColumnConstraints percentWidth="16.66"
                                           hgrow="ALWAYS"/>

                        <ColumnConstraints percentWidth="16.66"
                                           hgrow="ALWAYS"/>

                    </columnConstraints>


                    <!-- CLIENTES -->

                    <VBox GridPane.columnIndex="0"
                          styleClass="module-card"
                          alignment="CENTER"
                          spacing="5">

                        <Label text="♟"
                               styleClass="module-icon"/>

                        <Label text="Clientes"
                               styleClass="module-title"/>

                        <Label text="Registra y consulta&#10;tus clientes."
                               wrapText="true"
                               textAlignment="CENTER"
                               styleClass="module-description"/>

                        <Button text="›"
                                onAction="#abrirClientes"
                                styleClass="round-button"/>

                    </VBox>


                    <!-- PLANES -->

                    <VBox GridPane.columnIndex="1"
                          styleClass="module-card"
                          alignment="CENTER"
                          spacing="5">

                        <Label text="⚒"
                               styleClass="module-icon"/>

                        <Label text="Planes"
                               styleClass="module-title"/>

                        <Label text="Gestiona los planes&#10;del gimnasio."
                               wrapText="true"
                               textAlignment="CENTER"
                               styleClass="module-description"/>

                        <Button text="›"
                                onAction="#abrirPlanes"
                                styleClass="round-button"/>

                    </VBox>


                    <!-- ENTRENADORES -->

                    <VBox GridPane.columnIndex="2"
                          styleClass="module-card"
                          alignment="CENTER"
                          spacing="5">

                        <Label text="♟"
                               styleClass="module-icon"/>

                        <Label text="Entrenadores"
                               styleClass="module-title"/>

                        <Label text="Administra los&#10;entrenadores."
                               wrapText="true"
                               textAlignment="CENTER"
                               styleClass="module-description"/>

                        <Button text="›"
                                onAction="#abrirEntrenadores"
                                styleClass="round-button"/>

                    </VBox>


                    <!-- SERVICIOS -->

                    <VBox GridPane.columnIndex="3"
                          styleClass="module-card"
                          alignment="CENTER"
                          spacing="5">

                        <Label text="⚙"
                               styleClass="module-icon"/>

                        <Label text="Servicios"
                               styleClass="module-title"/>

                        <Label text="Servicios&#10;adicionales."
                               wrapText="true"
                               textAlignment="CENTER"
                               styleClass="module-description"/>

                        <Button text="›"
                                onAction="#abrirServicios"
                                styleClass="round-button"/>

                    </VBox>


                    <!-- INSCRIPCIONES -->

                    <VBox GridPane.columnIndex="4"
                          styleClass="module-card"
                          alignment="CENTER"
                          spacing="5">

                        <Label text="✓"
                               styleClass="module-icon"/>

                        <Label text="Inscripciones"
                               styleClass="module-title"/>

                        <Label text="Gestiona las&#10;inscripciones."
                               wrapText="true"
                               textAlignment="CENTER"
                               styleClass="module-description"/>

                        <Button text="›"
                                onAction="#abrirInscripciones"
                                styleClass="round-button"/>

                    </VBox>


                    <!-- REPORTES -->

                    <VBox GridPane.columnIndex="5"
                          styleClass="module-card"
                          alignment="CENTER"
                          spacing="5">

                        <Label text="▥"
                               styleClass="module-icon"/>

                        <Label text="Reportes"
                               styleClass="module-title"/>

                        <Label text="Consulta ingresos&#10;y estadísticas."
                               wrapText="true"
                               textAlignment="CENTER"
                               styleClass="module-description"/>

                        <Button text="›"
                                onAction="#abrirReportes"
                                styleClass="round-button"/>

                    </VBox>

                </GridPane>


                <!-- ================================================= -->
                <!-- PARTE INFERIOR -->
                <!-- ================================================= -->

                <GridPane hgap="15"
                          styleClass="bottom-grid"
                          VBox.vgrow="ALWAYS">

                    <columnConstraints>

                        <ColumnConstraints percentWidth="50"
                                           hgrow="ALWAYS"/>

                        <ColumnConstraints percentWidth="50"
                                           hgrow="ALWAYS"/>

                    </columnConstraints>

                    <rowConstraints>

                        <RowConstraints vgrow="ALWAYS"/>

                    </rowConstraints>


                    <!-- ================================================= -->
                    <!-- ACTIVIDAD RECIENTE -->
                    <!-- ================================================= -->

                    <VBox GridPane.columnIndex="0"
                          styleClass="dashboard-panel">

                        <HBox alignment="CENTER_LEFT">

                            <Label text="◷"
                                   styleClass="panel-icon"/>

                            <Label text="Actividad Reciente"
                                   styleClass="panel-title"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label text="Ver todos"
                                   styleClass="panel-link"/>

                        </HBox>


                        <TableView fx:id="tblActividad"
                                   VBox.vgrow="ALWAYS"
                                   styleClass="activity-table">

                            <columns>

                                <TableColumn fx:id="colCliente"
                                             text="Cliente"
                                             prefWidth="120"/>

                                <TableColumn fx:id="colPlan"
                                             text="Plan"
                                             prefWidth="120"/>

                                <TableColumn fx:id="colFecha"
                                             text="Fecha"
                                             prefWidth="100"/>

                                <TableColumn fx:id="colValor"
                                             text="Valor"
                                             prefWidth="100"/>

                            </columns>

                            <placeholder>

                                <Label text="No hay inscripciones recientes"/>

                            </placeholder>

                        </TableView>

                    </VBox>


                    <!-- ================================================= -->
                    <!-- ESTADISTICAS -->
                    <!-- ================================================= -->

                    <VBox GridPane.columnIndex="1"
                          styleClass="dashboard-panel">

                        <HBox alignment="CENTER_LEFT">

                            <Label text="▥"
                                   styleClass="panel-icon"/>

                            <Label text="Estadísticas Generales"
                                   styleClass="panel-title"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label text="Últimos 7 días"
                                   styleClass="filter-label"/>

                        </HBox>


                        <GridPane hgap="10"
                                  vgap="10">

                            <columnConstraints>

                                <ColumnConstraints percentWidth="50"
                                                   hgrow="ALWAYS"/>

                                <ColumnConstraints percentWidth="50"
                                                   hgrow="ALWAYS"/>

                            </columnConstraints>


                            <!-- CLIENTES -->

                            <HBox GridPane.columnIndex="0"
                                  GridPane.rowIndex="0"
                                  styleClass="stat-box"
                                  spacing="12">

                                <Label text="♟"
                                       styleClass="stat-icon"/>

                                <VBox>

                                    <Label fx:id="lblTotalClientes"
                                           text="0"
                                           styleClass="stat-number"/>

                                    <Label text="Clientes registrados"
                                           styleClass="stat-subtitle"/>

                                </VBox>

                            </HBox>


                            <!-- PLANES -->

                            <HBox GridPane.columnIndex="1"
                                  GridPane.rowIndex="0"
                                  styleClass="stat-box"
                                  spacing="12">

                                <Label text="⚒"
                                       styleClass="stat-icon"/>

                                <VBox>

                                    <Label fx:id="lblTotalPlanes"
                                           text="0"
                                           styleClass="stat-number"/>

                                    <Label text="Planes creados"
                                           styleClass="stat-subtitle"/>

                                </VBox>

                            </HBox>


                            <!-- INSCRIPCIONES -->

                            <HBox GridPane.columnIndex="0"
                                  GridPane.rowIndex="1"
                                  styleClass="stat-box"
                                  spacing="12">

                                <Label text="✓"
                                       styleClass="stat-icon"/>

                                <VBox>

                                    <Label fx:id="lblTotalInscripciones"
                                           text="0"
                                           styleClass="stat-number"/>

                                    <Label text="Inscripciones"
                                           styleClass="stat-subtitle"/>

                                </VBox>

                            </HBox>


                            <!-- INGRESOS -->

                            <HBox GridPane.columnIndex="1"
                                  GridPane.rowIndex="1"
                                  styleClass="stat-box"
                                  spacing="12">

                                <Label text="\$"
                                       styleClass="stat-money"/>

                                <VBox>

                                    <Label fx:id="lblIngresos"
                                           text="\$ 0,00"
                                           styleClass="stat-number"/>

                                    <Label text="Ingresos últimos 7 días"
                                           styleClass="stat-subtitle"/>

                                </VBox>

                            </HBox>

                        </GridPane>

                    </VBox>

                </GridPane>

            </VBox>

        </ScrollPane>

    </center>

</BorderPane>
