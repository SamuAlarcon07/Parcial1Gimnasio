<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.uniquindio.parcial1gimnasio.viewController.MainViewController"
      alignment="CENTER"
      spacing="20">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label fx:id="lblBienvenida"
           text="SmartGym"
           style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

    <Label text="Sistema de gestión del gimnasio"/>

    <Button text="Clientes"
            prefWidth="200"/>

    <Button text="Planes"
            prefWidth="200"/>

    <Button text="Inscripciones"
            prefWidth="200"/>

    <Button text="Servicios adicionales"
            prefWidth="200"/>

</VBox>