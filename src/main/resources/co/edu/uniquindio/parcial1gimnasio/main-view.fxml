<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uniquindio.parcial1gimnasio.viewController.MainViewController"
            stylesheets="@styles.css">


    <!-- ================================================= -->
    <!-- SIDEBAR -->
    <!-- ================================================= -->

    <left>

        <VBox prefWidth="235"
              minWidth="235"
              maxWidth="235"
              styleClass="sidebar"
              spacing="8">

            <!-- LOGO -->

            <VBox spacing="2"
                  styleClass="logo-container">

                <HBox alignment="CENTER_LEFT">

                    <Label text="Smart"
                           styleClass="logo"/>

                    <Label text="Gym"
                           styleClass="logo-orange"/>

                </HBox>

                <Label text="Sistema de gestión"
                       styleClass="logo-subtitle"/>

                <Label text="de gimnasio"
                       styleClass="logo-subtitle"/>

            </VBox>


            <!-- NAVEGACIÓN -->

            <Button text="⌂   Inicio"
                    styleClass="menu-button-active"
                    prefWidth="205"
                    maxWidth="205"/>

            <Button text="👥   Clientes"
                    onAction="#abrirClientes"
                    styleClass="menu-button"
                    prefWidth="205"
                    maxWidth="205"/>

            <Button text="🏋   Planes"
                    onAction="#abrirPlanes"
                    styleClass="menu-button"
                    prefWidth="205"
                    maxWidth="205"/>

            <Button text="👤   Entrenadores"
                    onAction="#abrirEntrenadores"
                    styleClass="menu-button"
                    prefWidth="205"
                    maxWidth="205"/>

            <Button text="⚙   Servicios"
                    onAction="#abrirServicios"
                    styleClass="menu-button"
                    prefWidth="205"
                    maxWidth="205"/>

            <Button text="✓   Inscripciones"
                    onAction="#abrirInscripciones"
                    styleClass="menu-button"
                    prefWidth="205"
                    maxWidth="205"/>

            <Button text="▥   Reportes"
                    onAction="#abrirReportes"
                    styleClass="menu-button"
                    prefWidth="205"
                    maxWidth="205"/>


            <!-- ESPACIO -->

            <VBox VBox.vgrow="ALWAYS"/>


            <!-- FRASE -->

            <VBox spacing="3"
                  styleClass="sidebar-quote">

                <Label text="DISCIPLINA"
                       styleClass="sidebar-phrase"/>

                <Label text="SALUD"
                       styleClass="sidebar-phrase"/>

                <Label text="BIENESTAR"
                       styleClass="sidebar-phrase-orange"/>

                <Label text="―"
                       styleClass="sidebar-line"/>

            </VBox>

        </VBox>

    </left>


    <!-- ================================================= -->
    <!-- CONTENIDO PRINCIPAL -->
    <!-- ================================================= -->

    <center>

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="main-scroll">

            <VBox spacing="18"
                  fillWidth="true"
                  styleClass="main-content">


                <!-- ================================================= -->
                <!-- HEADER -->
                <!-- ================================================= -->

                <HBox alignment="CENTER_RIGHT"
                      spacing="18"
                      maxWidth="Infinity"
                      styleClass="top-header">

                    <Label text="●  Usuario: Administrador"
                           styleClass="header-text"/>

                    <Label text="│"
                           styleClass="header-separator"/>

                    <Label text="▣  23 de septiembre de 2026"
                           styleClass="header-text"/>

                </HBox>


                <!-- ================================================= -->
                <!-- HERO -->
                <!-- ================================================= -->

                <StackPane styleClass="hero"
                           minWidth="0"
                           maxWidth="Infinity">


                    <!-- ================================================= -->
                    <!-- IMAGEN DE FONDO -->
                    <!-- ================================================= -->

                    <ImageView fx:id="imgBanner"
                               managed="false"
                               preserveRatio="true"
                               smooth="true"
                               mouseTransparent="true">

                        <image>
                            <Image url="@banner.png"/>
                        </image>

                    </ImageView>


                    <!-- ================================================= -->
                    <!-- CAPA OSCURA -->
                    <!-- ================================================= -->

                    <Region styleClass="hero-overlay"
                            mouseTransparent="true"/>


                    <!-- ================================================= -->
                    <!-- CONTENIDO DEL HERO -->
                    <!-- ================================================= -->

                    <HBox spacing="35"
                          fillHeight="true"
                          styleClass="hero-content">


                        <!-- TEXTO IZQUIERDO -->

                        <VBox spacing="9"
                              HBox.hgrow="ALWAYS">

                            <Label text="BIENVENIDO A"
                                   styleClass="hero-title-small"/>

                            <HBox spacing="0">

                                <Label text="SMART"
                                       styleClass="hero-title"/>

                                <Label text="GYM"
                                       styleClass="hero-title-orange"/>

                            </HBox>

                            <Label text="Gestiona tus clientes, planes,"
                                   styleClass="hero-description"/>

                            <Label text="entrenadores y mucho más, todo en un solo lugar."
                                   styleClass="hero-description"/>

                            <Label text="―"
                                   styleClass="orange-line"/>

                            <Label text="“Un cuerpo sano, una mente más fuerte.”"
                                   styleClass="hero-phrase"/>

                        </VBox>


                        <!-- PANEL DERECHO -->

                        <VBox alignment="CENTER"
                              spacing="3"
                              prefWidth="220"
                              minWidth="190"
                              maxWidth="250"
                              styleClass="hero-visual">

                            <Label text="DISCIPLINA"
                                   styleClass="hero-visual-text"/>

                            <Label text="RESULTADOS"
                                   styleClass="hero-visual-orange"/>

                            <Label text="BIENESTAR"
                                   styleClass="hero-visual-text"/>

                            <Label text="―"
                                   styleClass="hero-visual-line"/>

                        </VBox>

                    </HBox>

                </StackPane>


                <!-- ================================================= -->
                <!-- MÓDULOS PRINCIPALES -->
                <!-- ================================================= -->

                <Label text="Módulos principales"
                       styleClass="section-title"/>


                <GridPane hgap="14"
                          vgap="14"
                          minWidth="0"
                          maxWidth="Infinity">

                    <columnConstraints>

                        <ColumnConstraints percentWidth="32.5"
                                           hgrow="ALWAYS"
                                           fillWidth="true"/>

                        <ColumnConstraints percentWidth="32.5"
                                           hgrow="ALWAYS"
                                           fillWidth="true"/>

                        <ColumnConstraints percentWidth="32.5"
                                           hgrow="ALWAYS"
                                           fillWidth="true"/>

                    </columnConstraints>


                    <!-- CLIENTES -->

                    <VBox styleClass="module-card"
                          spacing="8"
                          minWidth="0"
                          maxWidth="Infinity"
                          GridPane.rowIndex="0"
                          GridPane.columnIndex="0">

                        <HBox alignment="CENTER_LEFT"
                              spacing="12"
                              minWidth="0">

                            <Label text="👥"
                                   styleClass="module-icon"/>

                            <VBox spacing="2"
                                  minWidth="0"
                                  HBox.hgrow="ALWAYS">

                                <Label text="Clientes"
                                       styleClass="module-title"/>

                                <Label text="Registra y consulta"
                                       styleClass="module-description"/>

                            </VBox>

                        </HBox>

                        <Button text="→"
                                onAction="#abrirClientes"
                                styleClass="round-button"/>

                    </VBox>


                    <!-- PLANES -->

                    <VBox styleClass="module-card"
                          spacing="8"
                          minWidth="0"
                          maxWidth="Infinity"
                          GridPane.rowIndex="0"
                          GridPane.columnIndex="1">

                        <HBox alignment="CENTER_LEFT"
                              spacing="12"
                              minWidth="0">

                            <Label text="🏋"
                                   styleClass="module-icon"/>

                            <VBox spacing="2"
                                  minWidth="0"
                                  HBox.hgrow="ALWAYS">

                                <Label text="Planes"
                                       styleClass="module-title"/>

                                <Label text="Gestiona los planes"
                                       styleClass="module-description"/>

                            </VBox>

                        </HBox>

                        <Button text="→"
                                onAction="#abrirPlanes"
                                styleClass="round-button"/>

                    </VBox>


                    <!-- ENTRENADORES -->

                    <VBox styleClass="module-card"
                          spacing="8"
                          minWidth="0"
                          maxWidth="Infinity"
                          GridPane.rowIndex="0"
                          GridPane.columnIndex="2">

                        <HBox alignment="CENTER_LEFT"
                              spacing="12"
                              minWidth="0">

                            <Label text="👤"
                                   styleClass="module-icon"/>

                            <VBox spacing="2"
                                  minWidth="0"
                                  HBox.hgrow="ALWAYS">

                                <Label text="Entrenadores"
                                       styleClass="module-title"/>

                                <Label text="Administra entrenadores"
                                       styleClass="module-description"/>

                            </VBox>

                        </HBox>

                        <Button text="→"
                                onAction="#abrirEntrenadores"
                                styleClass="round-button"/>

                    </VBox>


                    <!-- SERVICIOS -->

                    <VBox styleClass="module-card"
                          spacing="8"
                          minWidth="0"
                          maxWidth="Infinity"
                          GridPane.rowIndex="1"
                          GridPane.columnIndex="0">

                        <HBox alignment="CENTER_LEFT"
                              spacing="12"
                              minWidth="0">

                            <Label text="⚙"
                                   styleClass="module-icon"/>

                            <VBox spacing="2"
                                  minWidth="0"
                                  HBox.hgrow="ALWAYS">

                                <Label text="Servicios"
                                       styleClass="module-title"/>

                                <Label text="Servicios adicionales"
                                       styleClass="module-description"/>

                            </VBox>

                        </HBox>

                        <Button text="→"
                                onAction="#abrirServicios"
                                styleClass="round-button"/>

                    </VBox>


                    <!-- INSCRIPCIONES -->

                    <VBox styleClass="module-card"
                          spacing="8"
                          minWidth="0"
                          maxWidth="Infinity"
                          GridPane.rowIndex="1"
                          GridPane.columnIndex="1">

                        <HBox alignment="CENTER_LEFT"
                              spacing="12"
                              minWidth="0">

                            <Label text="✓"
                                   styleClass="module-icon"/>

                            <VBox spacing="2"
                                  minWidth="0"
                                  HBox.hgrow="ALWAYS">

                                <Label text="Inscripciones"
                                       styleClass="module-title"/>

                                <Label text="Gestiona las inscripciones"
                                       styleClass="module-description"/>

                            </VBox>

                        </HBox>

                        <Button text="→"
                                onAction="#abrirInscripciones"
                                styleClass="round-button"/>

                    </VBox>


                    <!-- REPORTES -->

                    <VBox styleClass="module-card"
                          spacing="8"
                          minWidth="0"
                          maxWidth="Infinity"
                          GridPane.rowIndex="1"
                          GridPane.columnIndex="2">

                        <HBox alignment="CENTER_LEFT"
                              spacing="12"
                              minWidth="0">

                            <Label text="▥"
                                   styleClass="module-icon"/>

                            <VBox spacing="2"
                                  minWidth="0"
                                  HBox.hgrow="ALWAYS">

                                <Label text="Reportes"
                                       styleClass="module-title"/>

                                <Label text="Ingresos y estadísticas"
                                       styleClass="module-description"/>

                            </VBox>

                        </HBox>

                        <Button text="→"
                                onAction="#abrirReportes"
                                styleClass="round-button"/>

                    </VBox>

                </GridPane>


                <!-- ================================================= -->
                <!-- RESUMEN GENERAL -->
                <!-- ================================================= -->

                <Label text="Resumen general"
                       styleClass="section-title"/>


                <GridPane hgap="14"
                          minWidth="0"
                          maxWidth="Infinity">

                    <columnConstraints>

                        <ColumnConstraints percentWidth="32.5"
                                           hgrow="ALWAYS"
                                           fillWidth="true"/>

                        <ColumnConstraints percentWidth="32.5"
                                           hgrow="ALWAYS"
                                           fillWidth="true"/>

                        <ColumnConstraints percentWidth="32.5"
                                           hgrow="ALWAYS"
                                           fillWidth="true"/>

                    </columnConstraints>


                    <!-- TOTAL CLIENTES -->

                    <HBox styleClass="stat-card"
                          spacing="15"
                          minWidth="0"
                          maxWidth="Infinity"
                          GridPane.columnIndex="0">

                        <Label text="👥"
                               styleClass="stat-icon"/>

                        <VBox spacing="2"
                              minWidth="0"
                              HBox.hgrow="ALWAYS">

                            <Label text="TOTAL DE CLIENTES"
                                   styleClass="stat-title"/>

                            <Label text="0"
                                   fx:id="lblTotalClientes"
                                   styleClass="stat-number"/>

                            <Label text="Clientes registrados"
                                   styleClass="stat-subtitle"/>

                        </VBox>

                    </HBox>


                    <!-- TOTAL PLANES -->

                    <HBox styleClass="stat-card"
                          spacing="15"
                          minWidth="0"
                          maxWidth="Infinity"
                          GridPane.columnIndex="1">

                        <Label text="🏋"
                               styleClass="stat-icon"/>

                        <VBox spacing="2"
                              minWidth="0"
                              HBox.hgrow="ALWAYS">

                            <Label text="PLANES DISPONIBLES"
                                   styleClass="stat-title"/>

                            <Label text="0"
                                   fx:id="lblTotalPlanes"
                                   styleClass="stat-number"/>

                            <Label text="Planes en el sistema"
                                   styleClass="stat-subtitle"/>

                        </VBox>

                    </HBox>


                    <!-- TOTAL INSCRIPCIONES -->

                    <HBox styleClass="stat-card"
                          spacing="15"
                          minWidth="0"
                          maxWidth="Infinity"
                          GridPane.columnIndex="2">

                        <Label text="✓"
                               styleClass="stat-icon"/>

                        <VBox spacing="2"
                              minWidth="0"
                              HBox.hgrow="ALWAYS">

                            <Label text="INSCRIPCIONES"
                                   styleClass="stat-title"/>

                            <Label text="0"
                                   fx:id="lblTotalInscripciones"
                                   styleClass="stat-number"/>

                            <Label text="Inscripciones realizadas"
                                   styleClass="stat-subtitle"/>

                        </VBox>

                    </HBox>

                </GridPane>


                <!-- ================================================= -->
                <!-- MENSAJE FINAL -->
                <!-- ================================================= -->

                <HBox alignment="CENTER"
                      styleClass="final-message">

                    <Label text="🏆  Entrena hoy, construye tu mañana."
                           styleClass="final-message-text"/>

                </HBox>


            </VBox>

        </ScrollPane>

    </center>

</BorderPane>